<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_nome"
        android:textColor="@color/vinho"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/alerta"
        android:textColor="@color/alerta"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/vazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/carregando"
        android:textColor="@color/suave"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/artigo1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:background="@drawable/linha_topo">
        <TextView
            android:id="@+id/artigo1_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/artigo1_fonte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/suave"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/artigo2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:background="@drawable/linha_topo">
        <TextView
            android:id="@+id/artigo2_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/artigo2_fonte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/suave"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/artigo3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:background="@drawable/linha_topo">
        <TextView
            android:id="@+id/artigo3_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/artigo3_fonte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/suave"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/botao_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/botao_bg"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:text="@string/botao_mapa"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
